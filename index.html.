<!doctype html>
<html lang="he" dir="rtl">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>המתכונים של אמא</title>
<style>
:root{--bg:#fff8f5;--paper:#fff;--ink:#352421;--muted:#866d68;--red:#b6404b;--red2:#e16a68;--line:#f0dcd6;--soft:#fff0ec;--gold:#f2bd71;--shadow:0 12px 35px #8d303012}
*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at 90% 0%,#ffe6df 0,transparent 38%),var(--bg);color:var(--ink);font-family:Arial,"Rubik","Heebo",sans-serif;min-height:100vh}
button,input,textarea,select{font:inherit}button{cursor:pointer;border:0;border-radius:14px;padding:11px 15px;font-weight:700;transition:.18s}button:hover{transform:translateY(-1px)}.primary{background:linear-gradient(135deg,var(--red),var(--red2));color:#fff;box-shadow:0 7px 18px #b6404b2b}.softbtn{background:var(--soft);color:var(--red);border:1px solid var(--line)}.iconbtn{background:#fff;border:1px solid var(--line);color:var(--muted);padding:8px 11px}
header{padding:24px clamp(16px,4vw,54px) 16px;max-width:1400px;margin:auto}.topline{display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap}.brand{display:flex;align-items:center;gap:13px}.logo{width:54px;height:54px;border-radius:18px;background:linear-gradient(145deg,#b6404b,#f08e7e);display:grid;place-items:center;font-size:28px;box-shadow:0 8px 18px #b6404b30}.brand h1{font-size:clamp(24px,4vw,36px);margin:0;letter-spacing:-.6px}.brand p{color:var(--muted);margin:5px 0 0;font-size:14px}.top-actions{display:flex;gap:8px;flex-wrap:wrap}.hero{margin:24px 0 16px;border-radius:28px;padding:clamp(22px,4vw,38px);background:linear-gradient(120deg,#732d38,#b6404b 62%,#df766f);color:white;position:relative;overflow:hidden;box-shadow:var(--shadow)}.hero:after{content:"✦";position:absolute;font-size:170px;left:3%;top:-55px;color:#ffffff12;transform:rotate(15deg)}.hero h2{font-size:clamp(23px,4vw,34px);margin:0 0 9px;position:relative;z-index:1}.hero p{margin:0;line-height:1.8;max-width:720px;color:#ffefed;position:relative;z-index:1}.hero .hero-actions{display:flex;gap:9px;flex-wrap:wrap;margin-top:20px;position:relative;z-index:1}.hero .lightbtn{background:white;color:#8f3540}.hero .outlinebtn{border:1px solid #ffffff70;color:#fff;background:#ffffff12}
.notice{background:#fff;border:1px solid var(--line);padding:14px 16px;border-radius:18px;display:flex;gap:12px;align-items:flex-start;margin:16px 0;color:var(--muted);line-height:1.65}.notice b{color:var(--ink)}.notice .bulb{font-size:23px}.notice a{color:var(--red)}main{max-width:1400px;margin:auto;padding:0 clamp(16px,4vw,54px) 50px}.toolbar{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin:22px 0 16px}.search{position:relative;flex:1;min-width:210px}.search input{width:100%;padding:14px 44px 14px 14px;border:1px solid var(--line);border-radius:15px;background:white;outline:none;color:var(--ink)}.search span{position:absolute;right:15px;top:12px;font-size:19px}.toolbar select{padding:13px;border:1px solid var(--line);border-radius:14px;background:white;color:var(--ink)}.stats{display:flex;gap:9px;flex-wrap:wrap;margin:15px 0 22px}.stat{background:#fff;border:1px solid var(--line);border-radius:14px;padding:10px 14px;color:var(--muted);font-size:13px}.stat strong{color:var(--red);font-size:18px;margin-left:5px}.section-head{display:flex;justify-content:space-between;align-items:center;gap:12px;margin:22px 0 14px}.section-head h2{font-size:22px;margin:0}.section-head p{margin:5px 0 0;color:var(--muted);font-size:13px}.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,275px),1fr));gap:16px}.card{background:var(--paper);border:1px solid var(--line);border-radius:22px;overflow:hidden;box-shadow:var(--shadow);display:flex;flex-direction:column;min-height:225px}.photo{height:160px;background:linear-gradient(135deg,#ffebe4,#f8d6d0);display:grid;place-items:center;color:#b76c67;font-size:44px;overflow:hidden;position:relative}.photo img{width:100%;height:100%;object-fit:cover}.photo .badge{position:absolute;top:10px;right:10px;background:#ffffffdf;color:#8a3340;border-radius:20px;font-size:11px;padding:6px 9px;font-weight:bold}.cardbody{padding:16px;display:flex;flex-direction:column;flex:1}.card h3{margin:0 0 8px;font-size:19px;line-height:1.4;overflow-wrap:anywhere}.desc{color:var(--muted);font-size:13px;line-height:1.65;white-space:pre-wrap;overflow-wrap:anywhere;display:-webkit-box;-webkit-line-clamp:4;-webkit-box-orient:vertical;overflow:hidden}.meta{display:flex;gap:7px;flex-wrap:wrap;margin-top:12px}.pill{background:#fff1ed;color:#a2484b;border-radius:20px;padding:5px 9px;font-size:11px}.cardactions{display:flex;gap:7px;margin-top:auto;padding-top:15px}.cardactions button{padding:9px 10px;font-size:12px}.cardactions .open{flex:1;background:#b6404b;color:white}.empty{padding:40px 18px;text-align:center;border:1px dashed #e4b9b1;border-radius:22px;background:#fff9f7}.empty .big{font-size:44px}.empty h3{margin:10px 0 7px}.empty p{color:var(--muted);line-height:1.8;max-width:620px;margin:0 auto 17px}.empty .mini{font-size:12px;color:#9e7c75;margin-top:12px}
.modalbg{position:fixed;inset:0;background:#26131685;display:none;align-items:center;justify-content:center;padding:15px;z-index:10;overflow:auto}.modalbg.show{display:flex}.modal{background:#fffaf8;width:min(760px,100%);max-height:92vh;overflow:auto;border-radius:24px;padding:23px;box-shadow:0 25px 80px #371b2050}.modalhead{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:16px}.modalhead h2{margin:0;font-size:23px}.formgrid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.field{display:flex;flex-direction:column;gap:7px;margin-bottom:13px}.field.full{grid-column:1/-1}.field label{font-size:13px;font-weight:bold;color:#76534e}.field input,.field textarea,.field select{width:100%;padding:12px;border:1px solid var(--line);border-radius:12px;background:#fff;color:var(--ink);outline-color:#d56b6c}.field textarea{min-height:140px;resize:vertical;line-height:1.7}.formbuttons{display:flex;justify-content:flex-start;gap:8px;flex-wrap:wrap;margin-top:12px}.smallnote{color:var(--muted);font-size:12px;line-height:1.7}.recipe-content{white-space:pre-wrap;line-height:1.9;overflow-wrap:anywhere}.detail-img{width:100%;max-height:330px;object-fit:cover;border-radius:16px;margin-bottom:14px}.toast{position:fixed;bottom:18px;right:50%;transform:translateX(50%);background:#382322;color:#fff;padding:12px 18px;border-radius:14px;z-index:20;display:none;max-width:90vw;text-align:center}.toast.show{display:block}.filehint{font-size:12px;color:var(--muted);line-height:1.7}.hidden{display:none!important}footer{max-width:1400px;margin:0 auto;padding:0 clamp(16px,4vw,54px) 30px;color:#9b8079;font-size:12px;line-height:1.8}
@media(max-width:600px){.topline{align-items:flex-start}.top-actions{width:100%}.top-actions button{flex:1}.hero{border-radius:22px}.formgrid{grid-template-columns:1fr}.field.full{grid-column:auto}.photo{height:145px}.toolbar select{flex:1}.section-head{align-items:flex-start}}
</style>
</head>
<body>
<header>
  <div class="topline">
    <div class="brand"><div class="logo">🍓</div><div><h1>המתכונים של אמא</h1><p>כל המתכונים במקום אחד, מסודרים ונוחים לחיפוש</p></div></div>
    <div class="top-actions"><button class="softbtn" id="importBtn">ייבוא מוואטסאפ</button><button class="primary" id="addBtn">＋ הוספת מתכון</button></div>
  </div>
  <section class="hero"><h2>פותחים את המחברת המשפחתית 🍰</h2><p>בעיקר קישורים למתכונים מאתרי אינטרנט — שומרים אותם במקום אחד, מחפשים לפי שם או אתר, מסמנים מועדפים ופותחים את המתכון המקורי בלחיצה.</p><div class="hero-actions"><button class="lightbtn" id="heroImport">להעביר מתכונים מוואטסאפ</button><button class="outlinebtn" id="heroAdd">לכתוב מתכון חדש</button></div></section>
  <div class="notice"><div class="bulb">💡</div><div><b>איך מעבירים את המתכונים אם זה לא הטלפון שלך?</b><br>לא חייבים שהטלפון של אמא יהיה אצלך. אם המתכונים נמצאים רק בוואטסאפ שלה, היא יכולה לייצא את הקבוצה ולשלוח לך את קובץ הטקסט. אם גם אתה חבר בקבוצה, אפשר לייצא אותה מהטלפון שלך. הייצוא יוצר עותק בלבד ולא מוחק את הצ׳אט. <a href="https://faq.whatsapp.com/1180414079177245/" target="_blank" rel="noreferrer">ההסבר הרשמי של WhatsApp</a>.</div></div>
</header>
<main>
  <div class="stats"><div class="stat"><strong id="countAll">0</strong>מתכונים</div><div class="stat"><strong id="countFav">0</strong>מועדפים</div><div class="stat"><strong id="countCats">0</strong>קטגוריות</div><div class="stat"><strong id="countImported">0</strong>יובאו מוואטסאפ</div></div>
  <div class="toolbar"><div class="search"><span>⌕</span><input id="search" type="search" placeholder="חיפוש מתכון, מצרך או מילה…" autocomplete="off"></div><select id="categoryFilter" aria-label="סינון לפי קטגוריה"><option value="all">כל הקטגוריות</option></select><select id="sort"><option value="new">נוספו לאחרונה</option><option value="az">שם המתכון א–ת</option><option value="fav">מועדפים קודם</option></select><button class="softbtn" id="favFilter">♡ רק מועדפים</button></div>
  <div class="section-head"><div><h2>ספר המתכונים</h2><p id="resultsLabel">כאן יופיעו המתכונים שתוסיפו או תייבאו</p></div><button class="iconbtn" id="backupBtn">גיבוי ↗</button></div>
  <div id="recipeGrid" class="grid"></div>
  <div id="emptyState" class="empty"><div class="big">📒</div><h3>בואו נכניס את המתכונים הראשונים</h3><p>הדרך הכי קלה היא לייצא את קבוצת המתכונים מוואטסאפ כקובץ טקסט. האתר יזהה קישורים בהודעות ויצור כרטיסים עם קישור למתכון המקורי.</p><button class="primary" id="emptyImport">ייבוא קובץ וואטסאפ</button> <button class="softbtn" id="emptyAdd">הוספת מתכון ידנית</button><div class="mini">המתכונים נשמרים בדפדפן במכשיר הזה. כדאי להוריד גיבוי מדי פעם.</div></div>
  <input type="file" id="chatFile" accept=".txt,text/plain" class="hidden"><input type="file" id="backupFile" accept=".json,application/json" class="hidden">
</main>
<footer>האתר שומר את הנתונים בדפדפן שבו פתחתם אותו, ולא שולח אותם לשרת. לכן פתיחה של קובץ האתר בטלפון אחר לא תעביר את המתכונים אוטומטית — השתמשו בכפתור ״גיבוי״ כדי להעביר אותם בין מכשירים. אל תייבאו שיחה פרטית בלי רשות המשתתפים.</footer>
<div class="modalbg" id="editModal"><div class="modal"><div class="modalhead"><h2 id="editHeading">הוספת מתכון</h2><button class="iconbtn" data-close="editModal">✕</button></div><form id="recipeForm"><input id="recipeId" type="hidden"><div class="formgrid"><div class="field"><label for="recipeTitle">שם המתכון *</label><input id="recipeTitle" required maxlength="120" placeholder="למשל: עוגת שוקולד עשירה"></div><div class="field"><label for="recipeCategory">קטגוריה</label><select id="recipeCategory"><option>עוגות וקינוחים</option><option>ארוחות</option><option>מאפים ולחמים</option><option>סלטים ותוספות</option><option>מרקים</option><option>שתייה</option><option>רטבים וממרחים</option><option>אחר</option></select></div><div class="field full"><label for="recipeUrl">קישור למתכון המקורי</label><input id="recipeUrl" type="url" placeholder="https://..." dir="ltr"><div class="filehint">הדביקו את הקישור מאתר המתכונים. האתר יפתח אותו בדף המקורי.</div></div><div class="field"><label for="recipeTime">זמן הכנה</label><input id="recipeTime" placeholder="למשל: 35 דקות"></div><div class="field"><label for="recipeServings">כמות / מנות</label><input id="recipeServings" placeholder="למשל: תבנית 24 ס״מ"></div><div class="field full"><label for="recipeIngredients">מצרכים</label><textarea id="recipeIngredients" placeholder="רשימת מצרכים, כל מצרך בשורה"></textarea></div><div class="field full"><label for="recipeInstructions">אופן הכנה / כל הטקסט של המתכון</label><textarea id="recipeInstructions" placeholder="שלבי ההכנה, הערות וטיפים"></textarea></div><div class="field full"><label for="recipeImage">תמונה של המתכון (לא חובה)</label><input id="recipeImage" type="file" accept="image/*"><div class="filehint" id="imageHint">אפשר להוסיף תמונה מהטלפון. התמונה תישמר בתוך ספר המתכונים בדפדפן.</div></div></div><div class="formbuttons"><button class="primary" type="submit">שמירת מתכון</button><button class="softbtn" type="button" data-close="editModal">ביטול</button></div></form></div></div>
<div class="modalbg" id="detailModal"><div class="modal"><div class="modalhead"><h2 id="detailTitle">מתכון</h2><button class="iconbtn" data-close="detailModal">✕</button></div><div id="detailBody"></div><div class="formbuttons"><button class="primary" id="detailEdit">עריכת מתכון</button><button class="softbtn" id="detailFav">♡ הוספה למועדפים</button><button class="softbtn" id="detailPrint">הדפסה</button></div></div></div>
<div class="modalbg" id="importModal"><div class="modal"><div class="modalhead"><h2>ייבוא מתכונים מוואטסאפ</h2><button class="iconbtn" data-close="importModal">✕</button></div><p style="line-height:1.8;color:#76534e;margin-top:0">1. פותחים את קבוצת המתכונים בוואטסאפ.<br>2. באנדרואיד: ⋮ ← עוד ← ייצוא צ׳אט. באייפון: לוחצים על שם הקבוצה ← ייצוא צ׳אט.<br>3. בוחרים <b>ללא מדיה</b> כדי להתחיל בפשטות, ושולחים/שומרים את קובץ ה־TXT אצלך.<br>4. כאן לוחצים על הכפתור למטה ובוחרים את קובץ ה־TXT.</p><div class="notice"><div>⚠️</div><div>האתר מחפש קישורים (בעיקר לאתרי מתכונים) בתוך כל הודעה ויוצר כרטיס לכל הודעה שיש בה קישור. הטקסט שלפני הקישור משמש כשם ראשוני. הודעות בלי קישור לא יובאו כברירת מחדל. תמונות לא נשלפות אוטומטית מקובץ הטקסט.</div></div><div class="formbuttons"><button class="primary" id="chooseChat">בחירת קובץ TXT</button><button class="softbtn" data-close="importModal">סגירה</button></div><p class="smallnote">אם הקבוצה נמצאת רק בטלפון של אמא, בקש ממנה לעשות את הייצוא ולשלוח לך את הקובץ. אין צורך למסור סיסמאות או קוד אימות.</p></div></div>
<div class="toast" id="toast"></div>
<script>
(()=>{
const $=id=>document.getElementById(id);let recipes=[];let onlyFav=false;let currentDetail=null;let pendingImage=null;
try{recipes=JSON.parse(localStorage.getItem('momRecipesV1')||'[]');if(!Array.isArray(recipes))recipes=[]}catch(e){recipes=[]}
const save=()=>{try{localStorage.setItem('momRecipesV1',JSON.stringify(recipes));return true}catch(e){toast('אין מספיק מקום לשמירה בדפדפן. נסו תמונה קטנה יותר או הסירו תמונות.');return false}};
function toast(msg){const t=$('toast');t.textContent=msg;t.classList.add('show');setTimeout(()=>t.classList.remove('show'),3000)}
function esc(s=''){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function showModal(id){$(id).classList.add('show')}function hideModal(id){$(id).classList.remove('show')}
function cats(){return [...new Set(recipes.map(r=>r.category||'אחר'))].sort((a,b)=>a.localeCompare(b,'he'))}
function render(){const q=$('search').value.trim().toLocaleLowerCase('he');const cat=$('categoryFilter').value;let arr=recipes.filter(r=>(cat==='all'||r.category===cat)&&(!onlyFav||r.favorite)&&[r.title,r.ingredients,r.instructions,r.category].some(x=>(x||'').toLocaleLowerCase('he').includes(q)));const sort=$('sort').value;if(sort==='az')arr.sort((a,b)=>a.title.localeCompare(b.title,'he'));else if(sort==='fav')arr.sort((a,b)=>Number(b.favorite)-Number(a.favorite));else arr.sort((a,b)=>(b.createdAt||0)-(a.createdAt||0));$('countAll').textContent=recipes.length;$('countFav').textContent=recipes.filter(r=>r.favorite).length;$('countCats').textContent=cats().length;$('countImported').textContent=recipes.filter(r=>r.imported).length;const old=$('categoryFilter').value;$('categoryFilter').innerHTML='<option value="all">כל הקטגוריות</option>'+cats().map(c=>`<option value="${esc(c)}">${esc(c)}</option>`).join('');if([...$('categoryFilter').options].some(o=>o.value===old))$('categoryFilter').value=old;$('resultsLabel').textContent=arr.length?`מוצגים ${arr.length} מתוך ${recipes.length} מתכונים`:'לא נמצאו מתכונים מתאימים';$('recipeGrid').innerHTML=arr.map(r=>`<article class="card"><div class="photo">${r.image?`<img src="${r.image}" alt="${esc(r.title)}">`:'🍲'}${r.imported?'<span class="badge">יובא מוואטסאפ</span>':''}</div><div class="cardbody"><h3>${esc(r.title||'מתכון ללא שם')}</h3><div class="desc">${esc((r.ingredients?('מצרכים:\n'+r.ingredients+'\n'):'')+(r.instructions||''))||'עדיין לא הוסיפו פרטים למתכון.'}</div><div class="meta"><span class="pill">${esc(r.category||'אחר')}</span>${r.time?`<span class="pill">⏱ ${esc(r.time)}</span>`:''}${r.favorite?'<span class="pill">♥ מועדף</span>':''}${r.url?'<span class="pill">🔗 קישור מקורי</span>':''}</div><div class="cardactions"><button class="open" data-open="${r.id}">לפרטי המתכון</button><button class="iconbtn" title="עריכה" data-edit="${r.id}">✎</button><button class="iconbtn" title="מועדפים" data-fav="${r.id}">${r.favorite?'♥':'♡'}</button></div></div></article>`).join('');$('emptyState').classList.toggle('hidden',recipes.length>0);$('recipeGrid').classList.toggle('hidden',recipes.length===0);if(recipes.length===0)$('resultsLabel').textContent='כאן יופיעו המתכונים שתוסיפו או תייבאו';else if(!arr.length){$('recipeGrid').innerHTML='<div class="empty" style="grid-column:1/-1"><div class="big">🔎</div><h3>לא מצאנו מתכונים</h3><p>נסו לשנות את החיפוש או את הסינון.</p></div>'}}
function addRecipe(){pendingImage=null;$('recipeForm').reset();$('recipeUrl').value='';$('recipeId').value='';$('editHeading').textContent='הוספת מתכון';$('imageHint').textContent='אפשר להוסיף תמונה מהטלפון. התמונה תישמר בתוך ספר המתכונים בדפדפן.';showModal('editModal')}
function editRecipe(id){const r=recipes.find(x=>x.id===id);if(!r)return;pendingImage=r.image||null;$('recipeId').value=r.id;$('recipeTitle').value=r.title||'';$('recipeUrl').value=r.url||'';$('recipeCategory').value=r.category||'אחר';$('recipeTime').value=r.time||'';$('recipeServings').value=r.servings||'';$('recipeIngredients').value=r.ingredients||'';$('recipeInstructions').value=r.instructions||'';$('imageHint').textContent=pendingImage?'לתמונה קיימת ישמרו הנתונים; בחירת תמונה חדשה תחליף אותה.':'אפשר להוסיף תמונה מהטלפון.';$('editHeading').textContent='עריכת מתכון';showModal('editModal')}
function detail(id){const r=recipes.find(x=>x.id===id);if(!r)return;currentDetail=id;$('detailTitle').textContent=r.title||'מתכון';$('detailBody').innerHTML=`${r.image?`<img class="detail-img" src="${r.image}" alt="${esc(r.title)}">`:''}<div class="meta" style="margin-bottom:14px"><span class="pill">${esc(r.category||'אחר')}</span>${r.time?`<span class="pill">⏱ ${esc(r.time)}</span>`:''}${r.servings?`<span class="pill">🍽 ${esc(r.servings)}</span>`:''}</div>${r.url?`<p><a class="primary" style="display:inline-block;text-decoration:none" href="${esc(r.url)}" target="_blank" rel="noopener noreferrer">🔗 פתיחת המתכון באתר המקורי</a></p>`:''}${r.ingredients?`<h3>מצרכים</h3><div class="recipe-content">${esc(r.ingredients)}</div>`:''}${r.instructions?`<h3 style="margin-top:20px">אופן הכנה / הערות</h3><div class="recipe-content">${esc(r.instructions)}</div>`:''}${!r.ingredients&&!r.instructions?'<p class="smallnote">אין עדיין פרטים למתכון. לחצו על ״עריכת מתכון״ כדי להוסיף אותם.</p>':''}`;$('detailFav').textContent=r.favorite?'♥ הסרה מהמועדפים':'♡ הוספה למועדפים';showModal('detailModal')}
function likelyRecipe(text){return /(https?:\/\/|www\.)/i.test(text)||/(מצרכים|אופן הכנה|אופן ההכנה|הוראות הכנה|מתכון|כוסות?|כפות?|גרם|קמח|סוכר|תנור|לאפות|לערבב|לבשל|לטגן|ביצים|שוקולד|ingredients|instructions|method|recipe)/i.test(text)}
function extractUrl(text){const m=text.match(/https?:\/\/[^\s<>]+|www\.[^\s<>]+/i);if(!m)return '';let u=m[0].replace(/[),.!?;\]】]+$/,'');if(u.startsWith('www.'))u='https://'+u;return validUrl(u)}
function validUrl(u){try{const x=new URL(u);return ['http:','https:'].includes(x.protocol)?x.href:''}catch(e){return ''}}
function titleFromLink(text,url,i){let before=text.replace(/https?:\/\/[^\s<>]+|www\.[^\s<>]+/ig,' ').replace(/[📌🔗🍰🍪🍕❤️]+/g,' ').replace(/\s+/g,' ').trim();before=before.replace(/^[-:|•\s]+|[-:|•\s]+$/g,'');if(before.length>90)before=before.slice(0,90);if(before.length>=3)return before;try{return 'מתכון מ־'+new URL(url).hostname.replace(/^www\./,'')}catch(e){return 'קישור למתכון '+i}}
function parseWhatsApp(raw){const lines=raw.replace(/^\uFEFF/,'').split(/\r?\n/);const messages=[];let current=null;const patterns=[/^\[?(\d{1,2}[./-]\d{1,2}[./-]\d{2,4},?\s+\d{1,2}:\d{2}(?::\d{2})?(?:\s*[AP]M)?)\]?\s*[-–]\s*(.*)$/, /^\[?(\d{1,2}\.\d{1,2}\.\d{2,4},?\s+\d{1,2}:\d{2})\]?\s*[-–]\s*(.*)$/];for(const line of lines){let m=null;for(const p of patterns){m=line.match(p);if(m)break}if(m){if(current)messages.push(current);let rest=m[2]||'';let colon=rest.indexOf(': ');let author=colon>-1?rest.slice(0,colon):'';let body=colon>-1?rest.slice(colon+2):rest;current={author,text:body.trim(),date:m[1]}}else if(current){current.text+='\n'+line}}if(current)messages.push(current);if(!messages.length){return lines.join('\n').trim()?[{author:'',text:lines.join('\n').trim(),date:''}]:[]}return messages.filter(m=>m.text&&!/Messages and calls are end-to-end encrypted|ההודעות והשיחות מוצפנות|changed the subject|שינה את נושא הקבוצה|added you|הוסיף אותך|left|עזב את הקבוצה/i.test(m.text))}
$('recipeForm').addEventListener('submit',async e=>{e.preventDefault();const id=$('recipeId').value||('r'+Date.now()+Math.random().toString(16).slice(2,6));const old=recipes.find(r=>r.id===id);let image=pendingImage;if($('recipeImage').files[0]){try{image=await compressImage($('recipeImage').files[0])}catch(err){toast('לא הצלחנו לקרוא את התמונה. אפשר לנסות תמונה אחרת.');return}}const r={id,title:$('recipeTitle').value.trim(),url:validUrl($('recipeUrl').value.trim()),category:$('recipeCategory').value||'אחר',time:$('recipeTime').value.trim(),servings:$('recipeServings').value.trim(),ingredients:$('recipeIngredients').value.trim(),instructions:$('recipeInstructions').value.trim(),image:image||null,favorite:old?.favorite||false,imported:old?.imported||false,createdAt:old?.createdAt||Date.now()};if(old)recipes=recipes.map(x=>x.id===id?r:x);else recipes.unshift(r);if(save()){hideModal('editModal');render();toast('המתכון נשמר 🌷')}});
function compressImage(file){return new Promise((resolve,reject)=>{const reader=new FileReader();reader.onerror=reject;reader.onload=()=>{const img=new Image();img.onerror=reject;img.onload=()=>{const scale=Math.min(1,1000/Math.max(img.width,img.height));const canvas=document.createElement('canvas');canvas.width=Math.round(img.width*scale);canvas.height=Math.round(img.height*scale);canvas.getContext('2d').drawImage(img,0,0,canvas.width,canvas.height);resolve(canvas.toDataURL('image/jpeg',.78))};img.src=reader.result};reader.readAsDataURL(file)})}
$('recipeGrid').addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;if(b.dataset.open)detail(b.dataset.open);if(b.dataset.edit)editRecipe(b.dataset.edit);if(b.dataset.fav){const r=recipes.find(x=>x.id===b.dataset.fav);if(r){r.favorite=!r.favorite;save();render()}}});$('search').addEventListener('input',render);$('categoryFilter').addEventListener('change',render);$('sort').addEventListener('change',render);$('favFilter').addEventListener('click',()=>{onlyFav=!onlyFav;$('favFilter').textContent=onlyFav?'♥ מציגים מועדפים':'♡ רק מועדפים';$('favFilter').classList.toggle('primary',onlyFav);render()});
['addBtn','heroAdd','emptyAdd'].forEach(id=>$(id).addEventListener('click',addRecipe));['importBtn','heroImport','emptyImport'].forEach(id=>$(id).addEventListener('click',()=>showModal('importModal')));document.querySelectorAll('[data-close]').forEach(b=>b.addEventListener('click',()=>hideModal(b.dataset.close)));document.querySelectorAll('.modalbg').forEach(bg=>bg.addEventListener('click',e=>{if(e.target===bg)hideModal(bg.id)}));$('chooseChat').addEventListener('click',()=>$('chatFile').click());$('chatFile').addEventListener('change',async e=>{const file=e.target.files[0];if(!file)return;try{const raw=await file.text();const msgs=parseWhatsApp(raw);if(!msgs.length){toast('לא נמצאו הודעות בקובץ. בדקו שבחרתם קובץ TXT מוואטסאפ.');return}const picked=msgs.filter(m=>extractUrl(m.text));if(!picked.length){toast('לא נמצאו קישורים בקובץ. בדקו שייצאתם את הצ׳אט הנכון.');return}const imported=picked.map((m,i)=>{const text=m.text.trim();const url=extractUrl(text);const title=titleFromLink(text,url,i+1);return{id:'r'+Date.now()+Math.random().toString(16).slice(2,8),title:title.slice(0,120),url,category:'אחר',time:'',servings:'',ingredients:'',instructions:text.replace(url,'').trim(),image:null,favorite:false,imported:true,createdAt:Date.now()+i,sourceAuthor:m.author||''}});recipes=[...imported,...recipes];if(save()){hideModal('importModal');render();toast(`יובאו ${imported.length} קישורים למתכונים! אפשר לערוך שמות וקטגוריות.`)}else{recipes=recipes.filter(r=>!imported.some(x=>x.id===r.id))}}catch(err){toast('אירעה שגיאה בקריאת הקובץ. נסו לייצא שוב כקובץ TXT.')}finally{e.target.value=''}});
$('backupBtn').addEventListener('click',()=>{if(!recipes.length){$('backupFile').click();return}const blob=new Blob([JSON.stringify({version:1,exportedAt:new Date().toISOString(),recipes},null,2)],{type:'application/json'});const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='המתכונים-של-אמא-גיבוי.json';a.click();URL.revokeObjectURL(a.href);toast('קובץ הגיבוי הורד')});$('backupFile').addEventListener('change',async e=>{const f=e.target.files[0];if(!f)return;try{const d=JSON.parse(await f.text());const arr=Array.isArray(d)?d:d.recipes;if(!Array.isArray(arr))throw new Error();if(confirm(`נמצאו ${arr.length} מתכונים בקובץ. למזג אותם עם המתכונים הקיימים? לחיצה על ביטול תחליף את הספר הנוכחי.`)){const ids=new Set(recipes.map(r=>r.id));recipes=[...arr.map(r=>ids.has(r.id)?{...r,id:r.id+'-imported-'+Date.now()}:r),...recipes]}else recipes=arr;if(save()){render();toast('הגיבוי נטען')}}catch(err){toast('קובץ הגיבוי לא תקין')}finally{e.target.value=''}});
$('detailEdit').addEventListener('click',()=>{const id=currentDetail;hideModal('detailModal');editRecipe(id)});$('detailFav').addEventListener('click',()=>{const r=recipes.find(x=>x.id===currentDetail);if(r){r.favorite=!r.favorite;save();detail(r.id);render()}});$('detailPrint').addEventListener('click',()=>{const r=recipes.find(x=>x.id===currentDetail);if(!r)return;const w=window.open('','_blank');if(!w){toast('הדפדפן חסם חלון הדפסה. נסו לאפשר חלונות קופצים.');return}w.document.write('<html lang="he" dir="rtl"><meta charset="utf-8"><title>'+esc(r.title)+'</title><style>body{font-family:Arial,sans-serif;max-width:760px;margin:40px auto;line-height:1.9;color:#302322;padding:0 20px}h1{color:#a93d47}pre{white-space:pre-wrap;font-family:inherit}</style><h1>'+esc(r.title)+'</h1><p>'+esc([r.category,r.time,r.servings].filter(Boolean).join(' · '))+'</p><h2>מצרכים</h2><pre>'+esc(r.ingredients||'')+'</pre><h2>אופן הכנה / הערות</h2><pre>'+esc(r.instructions||'')+'</pre></html>');w.document.close();w.focus();w.print()});
